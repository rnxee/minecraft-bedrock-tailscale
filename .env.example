# Copy this file to .env. Never commit .env.

COMPOSE_PROJECT_NAME=bedrock
COMPOSE_PROFILES=voice

# Set these after the Tailscale sidecar is authenticated.
TS_HOSTNAME=minecraft-bedrock
TS_DOMAIN=minecraft-bedrock.example.ts.net
# Optional. Prefer interactive `tailscale up` if you do not want an auth key in .env.
TS_AUTHKEY=

TAILSCALE_IMAGE=tailscale/tailscale:latest
BDS_IMAGE=itzg/minecraft-bedrock-server:latest
BDS_PLATFORM=linux/amd64
BVC_IMAGE=ghcr.io/alaydriem/bedrock-voice-chat/server:1.0.0-beta.23

SERVER_NAME="Mac Private Bedrock"
LEVEL_NAME="Voice World"
GAMEMODE=survival
DIFFICULTY=normal
MAX_PLAYERS=10
ALLOW_CHEATS=false
ALLOW_LIST=false
VERSION=LATEST

# Required by Bedrock Dedicated Server 26.60+.
TRANSPORT=nethernet
SERVER_UDP_PORTS=19140-19155

# Used by setup-voice.sh for the public BVC release it installs.
BVC_ADDON_URL=https://github.com/Alaydriem/bedrock-voice-chat/releases/download/mods-v1.0.0-beta.24/bvc-bds-pack-1.0.0-beta.24.mcaddon

